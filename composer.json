{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "career180/instructor-revenue-ledger",
    "type": "project",
    "description": "Instructor Revenue Ledger \u2014 subscription revenue allocation and instructor payout engine.",
    "keywords": [
        "laravel",
        "ledger",
        "payouts",
        "idempotency"
    ],
    "license": "MIT",
    "require": {
        "php": "~8.3.0",
        "filament/filament": "^3.3",
        "laravel/framework": "^11.56",
        "laravel/horizon": "^5.49",
        "laravel/tinker": "^2.9",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": "@php artisan test",
        "stan": "phpstan analyse --memory-limit=1G",
        "lint": "pint"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": {
                "PKSA-mdq4-51ck-6kdq": "Laravel 11 is pinned by the challenge spec (Tech Stack: Laravel 11). This advisory was only patched in 12.60.0 / 13.10.0 and has no 11.x backport, so it cannot be resolved without leaving the mandated major version. Accepted knowingly; see README.md > Assumptions.",
                "PKSA-3r5d-mb8f-1qw9": "Same as above \u2014 fixed in 12.60.0 only, no 11.x backport available.",
                "PKSA-m5cs-t1y6-qpcs": "Same as above \u2014 fixed in 12.61.1 / 13.12.0 only, no 11.x backport available."
            },
            "block-insecure": false
        },
        "platform": {
            "php": "8.3.33"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
