APP_NAME="Instructor Revenue Ledger"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Docker
#
# UID/GID are read by docker compose at build time so the container's `app` user
# matches the host developer. On Linux, set them to your own ids:
#   echo "UID=$(id -u)" >> .env && echo "GID=$(id -g)" >> .env
# -----------------------------------------------------------------------------
UID=1000
GID=1000

APP_PORT=8000
DB_FORWARD_PORT=3307
REDIS_FORWARD_PORT=6380

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
#
# DB_HOST is the compose service name: artisan and the test suite are meant to
# run inside the container (`docker compose exec app ...`). If you run them on
# the host instead, use DB_HOST=127.0.0.1 with DB_PORT=${DB_FORWARD_PORT}.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lms
DB_USERNAME=lms
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Created by docker/mysql/init/01-databases.sql. The suite runs on real MySQL,
# not SQLite — see that file for why.
DB_TEST_DATABASE=lms_test

# -----------------------------------------------------------------------------
# Sessions / cache / queue
#
# Redis for queue and cache. The queue driver matters: the payout pipeline is
# built on queued jobs that must survive worker crashes and be safely retried.
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="ledger@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
