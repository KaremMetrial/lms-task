# VCS & tooling
.git
.github
.idea
.vscode

# Dependencies — rebuilt inside the image by their own stage
vendor
node_modules

# Build output — regenerated by the assets stage
public/build
public/hot

# Local state that must never leak into an image layer
.env
.env.*
!.env.example
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
database/*.sqlite
.phpunit.cache
.phpunit.result.cache

# Docs & meta
docs
README.md
*.md
!composer.json
