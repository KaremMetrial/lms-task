<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="false"
         beStrictAboutOutputDuringTests="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            force="true" on every override below is load-bearing.

            docker compose passes the project .env into the container via
            env_file, so DB_DATABASE etc. exist as real process environment
            variables. PHPUnit will not shadow an already-set env var unless
            told to force it — without this, the suite silently runs against the
            development database and RefreshDatabase wipes real data.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>

        <!--
            The suite runs against real MySQL, not in-memory SQLite.

            Everything this project must prove depends on engine behaviour that
            SQLite either lacks or fakes:
              * unique-index violations as the idempotency mechanism
              * SELECT ... FOR UPDATE row locks during payout claiming
              * REPEATABLE READ snapshot semantics
              * deadlock detection and the retry path around it

            Passing tests on SQLite would say nothing about production, so the
            trade-off is accepted: the suite needs a running MySQL.
            DB_TEST_DATABASE is created by docker/mysql/init/01-databases.sql.
        -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="lms_test" force="true"/>

        <!--
            Redis, not the array store, because Cache::lock() is load-bearing in
            the payout pipeline. The array driver's lock is process-local, so it
            would make a broken distributed lock look correct.
            A dedicated Redis database keeps test runs from evicting dev cache.
        -->
        <env name="CACHE_STORE" value="redis" force="true"/>
        <env name="REDIS_CACHE_DB" value="2" force="true"/>

        <!--
            Not optional, and the reason took a bisect to find.

            config/cache.php declares the redis store as:
                'connection'      => 'cache'     (values)
                'lock_connection' => 'default'   (LOCKS)

            So by default Cache::lock() writes to a DIFFERENT Redis connection —
            and a different database — than Cache::put(). Cache::flush() issues
            FLUSHDB on the value connection only, so it leaves every lock behind.

            The effect on this suite: ShouldBeUnique jobs key their lock on a model
            id ("reconcile-payout-item:1"), RefreshDatabase resets auto-increment
            ids to 1, and a lock left by an earlier RUN silently swallows the
            dispatch for the next 300-600 seconds. The test then fails for a reason
            that has nothing to do with the code under test, and passes again ten
            minutes later.

            Pointing locks at the same connection as values means the Cache::flush()
            in Tests\TestCase::setUp() clears both, and runs become repeatable.
        -->
        <env name="REDIS_CACHE_LOCK_CONNECTION" value="cache" force="true"/>

        <!--
            `sync` by default: most tests drive jobs deliberately (dispatch,
            then handle again) to assert that a replay is a no-op. Tests that
            need real queue mechanics opt in explicitly with Queue::fake() or by
            switching the connection inside the test.
        -->
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>

        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
