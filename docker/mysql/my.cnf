[mysqld]
# ----------------------------------------------------------------------------
# Money correctness settings.
#
# STRICT_ALL_TABLES makes MySQL reject out-of-range or truncated values with an
# error instead of silently coercing them. In a ledger, a silently truncated
# amount is a corrupted balance, so this is non-negotiable.
# ----------------------------------------------------------------------------
sql_mode = STRICT_ALL_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION,NO_ZERO_DATE,NO_ZERO_IN_DATE

# REPEATABLE READ is MySQL's default and is what the payout locking strategy is
# written against. Stated explicitly so it is never an accident.
transaction_isolation = REPEATABLE-READ

# Every table is InnoDB: we depend on row locks, foreign keys and real
# transactions.
default_storage_engine = InnoDB

# Flush the log at every commit. Slower, but a committed payout that vanishes
# on power loss is unacceptable.
innodb_flush_log_at_trx_commit = 1

character_set_server = utf8mb4
collation_server = utf8mb4_unicode_ci

# Deadlocks are an expected part of the concurrent payout design; log them so
# the retry behaviour can be verified rather than assumed.
innodb_print_all_deadlocks = ON
